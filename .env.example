# GitHub OAuth App (for "Login with GitHub" in the CMS)
# Create an OAuth App at: https://github.com/settings/developers
#
# For LOCAL development:
#   Callback URL: http://localhost:3000/api/cms/auth/callback
#
# For NETLIFY production:
#   Create a second OAuth App (or update the callback URL) to:
#   https://your-site.netlify.app/api/cms/auth/callback
#   Then set these same variables in Netlify → Site settings → Environment variables

GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# The public URL of this site — used to build the OAuth callback URL
# Local dev: http://localhost:3000
# Production: https://your-site.netlify.app
SITE_URL=http://localhost:3000
